# 复制成 .env 并填入自己的 key：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交

# ---------- 阿里通义千问 Qwen-VL-Max（推荐，国内直连）----------
LLM_API_KEY=sk-在这里填你的DashScope密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-max

# ---------- 或者 OpenAI 官方 ----------
# LLM_API_KEY=sk-在这里填你的OpenAI密钥
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini

# 若接口报错 "response_format is not supported"，取消下面这行的注释
# LLM_JSON_MODE=0

# ---------- 语音识别 ----------
# STT_MODEL=small
# STT_CPU_THREADS=1
# 国内下载 Whisper 模型需要镜像（或直接在 shell 里 export）
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1

# ---------- 语音合成 ----------
# TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------- 面试流程 ----------
# MAX_TURNS=5
